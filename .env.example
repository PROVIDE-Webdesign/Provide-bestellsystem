# Ausschließlich unkritische lokale Beispielwerte. Niemals echte Zugangsdaten eintragen.
APP_ENV=development
PUBLIC_STOREFRONT_URL=http://localhost:3000
PUBLIC_DASHBOARD_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8787
DATABASE_URL=postgresql://provide_local:provide_local@127.0.0.1:5432/provide_orders
AUTH_SESSION_SECRET=local-example-not-a-secret-change-me
API_ALLOWED_ORIGINS=http://localhost:3000

# Erst nach Prüfung der Hyperdrive-Konfiguration aktivieren.
HYPERDRIVE_CACHE_DISABLED=false

# Öffentliche Schreibwege bleiben ohne ausdrückliches Preview-/Produktions-Gate geschlossen.
CHECKOUT_WRITE_ENABLED=false
CHECKOUT_PRIVACY_NOTICE_VERSION=preview-v1
CHECKOUT_RETENTION_DAYS=30
PUBLIC_CHECKOUT_PRIVACY_NOTICE_VERSION=preview-v1
