{
  "name": "@provide/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @provide/contracts build && node ../../scripts/build-asian-kitchen-demo.mjs && vinext build",
    "deploy:preview": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "dev": "vinext dev",
    "lint": "eslint .",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "node --experimental-strip-types tests/browser/run.ts",
    "deploy:cloud-preview": "node ../../scripts/prepare-storefront-cloud-build.mjs && wrangler deploy --config dist/server/wrangler.json --keep-vars"
  },
  "dependencies": {
    "@provide/contracts": "workspace:*",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.9.1",
    "playwright": "catalog:",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
