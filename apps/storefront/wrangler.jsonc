{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "provide-bs-storefront-preview",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": false,
  },
  "vars": {
    "APP_ENV": "preview",
    "PUBLIC_ONLINE_PAYMENT_ENABLED": "false",
    "PUBLIC_API_URL": "https://replace-with-preview-api.example.invalid",
    "PUBLIC_CHECKOUT_PRIVACY_NOTICE_VERSION": "preview-v1",
  },
  "observability": {
    "enabled": true,
  },
}
